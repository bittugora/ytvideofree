PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
YTTAKEN_OUTPUT_DIR=/var/lib/ytvideofree/tmp
YTTAKEN_FFMPEG_LOCATION=/usr/bin/ffmpeg
YTTAKEN_NODE_LOCATION=/usr/bin/node

# Set this after DNS is pointed at the VPS. Keep localhost for health checks.
YTTAKEN_ALLOWED_HOSTS=ytvideofree.com,www.ytvideofree.com,127.0.0.1,localhost

# Optional: only use a cookies file for accounts and videos you are allowed to access.
YTTAKEN_COOKIES_FILE=
