PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
YTVIDEOFREE_OUTPUT_DIR=/var/lib/ytvideofree/tmp
YTVIDEOFREE_FFMPEG_LOCATION=/usr/bin/ffmpeg
YTVIDEOFREE_NODE_LOCATION=/usr/bin/node

# If the VPS image has no Node.js, the app auto-downloads a standalone Node
# binary on first use. Set to 0 to disable.
YTVIDEOFREE_AUTO_RUNTIME=1
# Where the auto-downloaded runtime is stored (defaults to .cache/runtimes).
YTVIDEOFREE_RUNTIME_DIR=/var/lib/ytvideofree/runtimes

# Set this after DNS is pointed at the VPS. Keep localhost for health checks.
YTVIDEOFREE_ALLOWED_HOSTS=ytvideofree.com,www.ytvideofree.com,127.0.0.1,localhost

# Player-client groups tried in order when YouTube bot-checks the server IP.
# The default (tv+web_safari first) works from datacenter/VPS IPs without
# cookies or a JS runtime. ":" joins clients within a group; "," separates
# groups. Leave unset to use the built-in sequence.
# YTVIDEOFREE_PLAYER_CLIENTS=tv:web_safari,ios:android,mweb,tv_embedded,web

# Optional: only use a cookies file for accounts and videos you are allowed to access.
YTVIDEOFREE_COOKIES_FILE=
