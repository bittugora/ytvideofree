PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
YTVIDEOFREE_OUTPUT_DIR=/var/lib/ytvideofree/tmp
YTVIDEOFREE_FFMPEG_LOCATION=/usr/bin/ffmpeg
YTVIDEOFREE_NODE_LOCATION=/usr/bin/node

# Set this after DNS is pointed at the VPS. Keep localhost for health checks.
YTVIDEOFREE_ALLOWED_HOSTS=ytvideofree.com,www.ytvideofree.com,127.0.0.1,localhost

# Optional: only use a cookies file for accounts and videos you are allowed to access.
YTVIDEOFREE_COOKIES_FILE=
