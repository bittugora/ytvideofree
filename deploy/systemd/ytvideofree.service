[Unit]
Description=ytvideofree Django application
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ytvideofree
Group=ytvideofree
WorkingDirectory=/var/www/ytvideofree
EnvironmentFile=/etc/ytvideofree/ytvideofree.env
ExecStartPre=/var/www/ytvideofree/.venv/bin/python manage.py migrate --noinput
# --timeout 300: YouTube extraction/downloads can take well over the
# gunicorn default 30s, which would kill the worker mid-request.
ExecStart=/var/www/ytvideofree/.venv/bin/gunicorn ytvideofree.wsgi:application --bind 127.0.0.1:8000 --workers 2 --proxy-headers --timeout 300 --graceful-timeout 60
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/ytvideofree /var/log/ytvideofree /tmp

[Install]
WantedBy=multi-user.target
