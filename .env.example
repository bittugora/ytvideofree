[TEMPLATE]
[TEMPLATE]
# Django. Generate one with `python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"`.
DJANGO_SECRET_KEY=
# Set to 0 in production.
DJANGO_DEBUG=1

# Comma-separated allowed Host headers. Leave empty to allow all (dev only).
YTTAKEN_ALLOWED_HOSTS=

# Directory for temporary download files. Docker defaults this to /tmp.
YTTAKEN_OUTPUT_DIR=/tmp

# Optional explicit binary locations.
YTTAKEN_FFMPEG_LOCATION=
YTTAKEN_NODE_LOCATION=

# JavaScript runtimes for yt-dlp's YouTube anti-bot solver. Modern yt-dlp needs
# an external JS runtime (deno, node, bun, quickjs) to pass YouTube's bot
# checks; only deno is enabled by default, so node/bun are auto-detected from
# PATH when unset. Set a comma-separated list to force specific runtimes, e.g.
# YTTAKEN_JS_RUNTIMES=node,bun
YTTAKEN_JS_RUNTIMES=
YTTAKEN_DENO_LOCATION=
YTTAKEN_BUN_LOCATION=
YTTAKEN_QUICKJS_LOCATION=

# Optional yt-dlp cookies file path for deployments that need authenticated access.
# Use only with accounts and content you are allowed to access.
YTTAKEN_COOKIES_FILE=
